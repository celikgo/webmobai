{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/main/crates/tauri-utils/schema.json",
  "identifier": "default",
  "description": "Default capabilities for WebMobAI",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "node-version", "cmd": "node", "args": ["--version"] },
        {
          "name": "node-run",
          "cmd": "node",
          "args": [
            { "validator": ".*[/\\\\]auto-test\\.js" },
            { "validator": ".+" },
            { "validator": "\\{.*\\}" }
          ]
        },
        {
          "name": "cat-history",
          "cmd": "cat",
          "args": [{ "validator": ".*history\\.json" }]
        },
        {
          "name": "open-reveal",
          "cmd": "open",
          "args": ["-R", { "validator": "/.+" }]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "node-version", "cmd": "node", "args": ["--version"] },
        {
          "name": "node-run",
          "cmd": "node",
          "args": [
            { "validator": ".*[/\\\\]auto-test\\.js" },
            { "validator": ".+" },
            { "validator": "\\{.*\\}" }
          ]
        },
        {
          "name": "cat-history",
          "cmd": "cat",
          "args": [{ "validator": ".*history\\.json" }]
        },
        {
          "name": "open-reveal",
          "cmd": "open",
          "args": ["-R", { "validator": "/.+" }]
        }
      ]
    }
  ]
}
